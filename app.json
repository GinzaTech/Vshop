{
  "expo": {
    "name": "VShop",
    "slug": "vshop",
    "version": "4.1.5",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "vshop",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/90bdf4e2-2472-4cd1-a168-4a5ee4e62218",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "dev.vasc.vshop",
      "buildNumber": "38",
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2f343b"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "package": "com.android.vshop",
      "versionCode": 86
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-updates",
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép VShop truy cập thư viện ảnh.",
          "savePhotosPermission": "Cho phép VShop lưu ảnh bộ sưu tập vào thư viện.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7b838f"
        }
      ],
      "react-native-background-fetch",
      [
        "@preeternal/react-native-cookie-manager",
        {
          "androidWebkitVersion": "1.16.0"
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-v3.png",
          "resizeMode": "contain",
          "backgroundColor": "#f4f6f9"
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "90bdf4e2-2472-4cd1-a168-4a5ee4e62218"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "hyeon004"
  }
}
