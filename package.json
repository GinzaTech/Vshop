{
  "name": "vshop",
  "main": "index.ts",
  "version": "4.1.8",
  "scripts": {
    "start": "expo start",
    "start:perf": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --config jest.full.config.js --ci --runInBand --coverage",
    "test:critical": "jest --ci --runInBand --coverage",
    "test:api": "node scripts/smoke-api.mjs",
    "audit:prod": "node scripts/audit-production.mjs",
    "check:export-budget": "node scripts/check-export-budget.mjs",
    "check:source": "pnpm run typecheck && pnpm run lint && pnpm run test:ci && pnpm run audit:prod",
    "check:android": "node scripts/check-android-export.mjs",
    "check": "pnpm run check:source && pnpm run check:android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
